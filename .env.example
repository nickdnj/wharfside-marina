# =============================================================================
# Wharfside Marina — env template
#
# Copy to `.env.local` and fill in. Production values live in Vercel's
# Environment Variables panel; mirror this file there.
#
# Provisioning steps for each service: see docs/ops/PROVISION.md
# Smoke-test that everything is wired up: `pnpm verify:infra`
# =============================================================================

# ----- Site URL (canonical host) ---------------------------------------------
# Public origin of the deployed site. Used by sitemap, robots, OpenGraph,
# JSON-LD. Leave commented locally to fall back to https://wharfsidemb.com.
# NEXT_PUBLIC_SITE_URL="https://wharfsidemb.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Database — Neon Postgres ----------------------------------------------
# Connection string from Neon → your project → Branches → dev branch.
# `?sslmode=require` is mandatory for Neon. For migrations + Drizzle Studio.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Separate URL for the `test` schema/branch — used by `pnpm test` only.
# TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"

# ----- Auth.js v5 ------------------------------------------------------------
# AUTH_SECRET: 32-byte random hex string. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ----- Email — Resend --------------------------------------------------------
# API key from resend.com → API Keys. Required for sending transactional
# email (magic-link sign-in, transient request confirmations, reminders).
# Without it, send paths silently no-op (dev-friendly).
RESEND_API_KEY=""
EMAIL_FROM="Wharfside Marina <no-reply@wharfsidemb.com>"

# Recipient for transient-request notification emails. Defaults to
# kathy.vanecek@idealmgt.com if unset.
# ECI_NOTIFICATION_EMAIL="kathy.vanecek@idealmgt.com"

# ----- Storage — Cloudflare R2 -----------------------------------------------
# Provision: Cloudflare dashboard → R2 → Create bucket
# Tokens: R2 → Manage R2 API Tokens → Create token (Object R/W on the bucket).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="wharfside-marina-docs"
# R2 public dev URL (if you opt into public access) or empty if signed-only.
R2_PUBLIC_URL=""

# ----- Rate limiting — Upstash Redis -----------------------------------------
# Provision: console.upstash.com → Create Redis database (Global, free tier).
# Used by /transient form (5 submissions per IP per hour). Without these,
# rate-limit allows everything (dev-friendly).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Observability — Sentry (optional for MVP) -----------------------------
# Provision: sentry.io → create Next.js project.
SENTRY_DSN=""

# ----- Seed script -----------------------------------------------------------
# Set to "true" to allow the seed script to run against a non-empty database
# (it normally aborts to protect prod data).
# SEED_FORCE="true"
